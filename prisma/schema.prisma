generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  role         String   @default("USER") // USER or ADMIN
  createdAt    DateTime @default(now())
  
  threads      Thread[]
}

model Thread {
  id         String   @id @default(uuid())
  title      String
  content    String
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  authorName String   // Cached name for quick access
  createdAt  DateTime @default(now())
}

